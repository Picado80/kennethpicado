{"text": "<style>\n  .rt { display: grid; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); }\n  .rt-head h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n  .rt-head p { margin: var(--cds-gap-xs) 0 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-body); max-width: 70ch; }\n  .rt-tiles { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }\n  .rt-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n  .rt-tile .lab { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .rt-tile .big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; margin: var(--cds-gap-xs) 0; }\n  .rt-tile .sub { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n  .rt-tile .meta { color: var(--color-fg); }\n  .rt-grid { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }\n  .rt-card h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n  .rt-card .nota { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: var(--cds-gap-xs) 0 var(--cds-gap-md); }\n  .rt-chart { position: relative; min-height: 240px; }\n  .rt-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius);\n    box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; z-index: 2; }\n  .rt-tip .t { color: var(--cds-text-secondary); }\n  .rt-sw { display: inline-block; width: .6rem; height: .6rem; border-radius: 2px; margin-right: .35rem; }\n  .rt-legend { display: flex; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-bottom: var(--cds-gap-sm); flex-wrap: wrap; }\n  .rt-table-wrap { max-height: 32rem; overflow: auto; }\n  .rt-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .rt-table th, .rt-table td { padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); text-align: left; }\n  .rt-table th { position: sticky; top: 0; background: var(--color-panel); font-weight: var(--cds-font-weight-medium); }\n  .rt-table th button { all: unset; cursor: pointer; }\n  .rt-table th button:focus-visible { outline: 2px solid var(--cds-chart-reference); }\n  .rt-table .n { text-align: right; }\n  .rt-bar { display: inline-block; height: .45rem; border-radius: 3px; background: var(--cds-chart-muted); margin-left: .4rem; vertical-align: middle; }\n  .rt-pill { display: inline-block; padding: 0 .45rem; border-radius: 99px; border: 1px solid var(--color-border-line); }\n  .rt-fb { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  [data-dash-source-state=empty] { color: transparent; }\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n  @media (max-width: 40rem) { .rt-table .opt { display: none; } }\n</style>\n\n<div class=\"rt\">\n  <header class=\"rt-head\" id=\"resumen\">\n    <h1>Reto 30 días · Vistas y seguidores</h1>\n    <p id=\"rt-takeaway\"><span class=\"dash-skeleton\">—</span></p>\n  </header>\n\n  <section class=\"rt-tiles\" id=\"cifras\">\n    <div class=\"rt-card rt-tile\">\n      <div class=\"lab\">Vistas totales · TikTok + Instagram</div>\n      <div class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"vistas_total\" data-row=\"0\">—</div>\n      <div class=\"sub\">TikTok <span data-source=\"resumen\" data-field=\"vistas_tiktok\" data-row=\"0\">—</span> · Instagram <span data-source=\"resumen\" data-field=\"vistas_instagram\" data-row=\"0\">—</span></div>\n    </div>\n    <div class=\"rt-card rt-tile\">\n      <div class=\"lab\">Vistas promedio por video</div>\n      <div class=\"big\"><span class=\"dash-skeleton\" data-source=\"resumen\" data-field=\"prom_tiktok\" data-row=\"0\">—</span> <span class=\"sub\">en TikTok</span></div>\n      <div class=\"sub\">Instagram: <span data-source=\"resumen\" data-field=\"prom_instagram\" data-row=\"0\">—</span> por video</div>\n    </div>\n    <div class=\"rt-card rt-tile\">\n      <div class=\"lab\">Seguidores hoy · TikTok + Instagram</div>\n      <div class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"seguidores_hoy\" data-row=\"0\">—</div>\n      <div class=\"sub\"><span class=\"meta\" data-source=\"resumen\" data-field=\"nuevos\" data-row=\"0\">—</span> desde el inicio · faltan <span data-source=\"resumen\" data-field=\"faltan\" data-row=\"0\">—</span> para 2.659</div>\n    </div>\n    <div class=\"rt-card rt-tile\">\n      <div class=\"lab\">Seguidores nuevos por cada 1.000 vistas</div>\n      <div class=\"big dash-skeleton\" data-source=\"resumen\" data-field=\"por_mil\" data-row=\"0\">—</div>\n      <div class=\"sub\">Más vistas = más seguidores: a este ritmo, la meta pide <span data-source=\"resumen\" data-field=\"vistas_para_meta\" data-row=\"0\">—</span> vistas</div>\n    </div>\n  </section>\n\n  <section class=\"rt-grid\">\n    <div class=\"rt-card\" id=\"vistas-por-dia\">\n      <h2>Vistas por día de publicación</h2>\n      <p class=\"nota\">Suma de las vistas de lo que salió cada día, por red. Lo nuevo sigue sumando vistas por varios días.</p>\n      <div class=\"rt-legend\" id=\"ley-dia\"></div>\n      <div class=\"rt-chart\" id=\"chart-dia\" data-source=\"vistas_por_dia\"></div>\n    </div>\n    <div class=\"rt-card\" id=\"crecimiento-vistas\">\n      <h2>Crecimiento de las vistas</h2>\n      <p class=\"nota\">Vistas acumuladas de todo lo publicado, en cada medición. Una medición por día.</p>\n      <div class=\"rt-legend\" id=\"ley-hist\"></div>\n      <div class=\"rt-chart\" id=\"chart-hist\" data-source=\"historial\"></div>\n    </div>\n    <div class=\"rt-card\" id=\"seguidores\">\n      <h2>Seguidores contra la meta</h2>\n      <p class=\"nota\">TikTok + Instagram. La línea punteada es el camino a 2.659 el Día 30 (19 de noviembre).</p>\n      <div class=\"rt-chart\" id=\"chart-seg\" data-source=\"seguidores\"></div>\n    </div>\n  </section>\n\n  <section class=\"rt-card\" id=\"publicaciones\">\n    <h2>Cada publicación</h2>\n    <p class=\"nota\">«Visto» es el tiempo promedio visto sobre lo que dura el video (más de 100 %: lo vieron más de una vez). Tocá un encabezado para ordenar.</p>\n    <div class=\"rt-table-wrap\">\n      <table class=\"rt-table\" data-source=\"publicaciones\" data-row-key=\"codigo,red\">\n        <thead><tr>\n          <th data-field=\"fecha\"><button data-k=\"fecha\">Fecha</button></th>\n          <th data-field=\"pieza\"><button data-k=\"pieza\">Pieza</button></th>\n          <th data-field=\"red\"><button data-k=\"red\">Red</button></th>\n          <th data-field=\"vistas\" class=\"n\"><button data-k=\"vistas\">Vistas</button></th>\n          <th data-field=\"visto\" class=\"n\"><button data-k=\"visto\">Visto</button></th>\n          <th data-field=\"reacciones\" class=\"n opt\"><button data-k=\"reacciones\">Reacciones</button></th>\n          <th data-field=\"compartidos\" class=\"n opt\"><button data-k=\"compartidos\">Compartidos</button></th>\n          <th data-field=\"comentarios\" class=\"n opt\"><button data-k=\"comentarios\">Comentarios</button></th>\n        </tr></thead>\n        <tbody id=\"rt-filas\"></tbody>\n      </table>\n    </div>\n    <p class=\"rt-fb\">Facebook todavía no está conectado en Buffer: cuando se conecte, sus números entran acá.</p>\n  </section>\n</div>\n\n<script>\n  window.rtFmt = d3.formatLocale({ decimal: ',', thousands: '.', grouping: [3], currency: ['₡', ''] });\n\n  dash.calc('resumen', {\n    title: 'Resumen del reto',\n    description: 'Totales y promedios de vistas por red, seguidores de la última medición contra el inicio (1.659) y la meta (2.659).',\n    inputs: ['publicaciones', 'seguidores'],\n    fn: (publicaciones, seguidores) => {\n      const red = (r) => publicaciones.filter((p) => p.red === r);\n      const suma = (xs) => xs.reduce((s, p) => s + Number(p.vistas), 0);\n      const tt = red('TikTok'), ig = red('Instagram');\n      const ultimo = seguidores.slice().sort((a, b) => (a.fecha < b.fecha ? -1 : 1)).pop() || {};\n      const total = suma(publicaciones), hoy = Number(ultimo.total), nuevos = hoy - 1659;\n      const mejor = publicaciones.slice().sort((a, b) => b.vistas - a.vistas)[0] || {};\n      const porMil = total ? (nuevos / total) * 1000 : 0;\n      return [{\n        vistas_total: total, vistas_tiktok: suma(tt), vistas_instagram: suma(ig),\n        prom_tiktok: tt.length ? Math.round(suma(tt) / tt.length) : 0, prom_instagram: ig.length ? Math.round(suma(ig) / ig.length) : 0,\n        seguidores_hoy: hoy, nuevos, faltan: 2659 - hoy, por_mil: Math.round(porMil * 10) / 10,\n        vistas_para_meta: porMil > 0 ? Math.round((1000 / porMil) * 1000) : null,\n        mejor_pieza: mejor.pieza, mejor_red: mejor.red, mejor_vistas: mejor.vistas, fecha_seguidores: ultimo.fecha,\n      }];\n    },\n  });\n\n  dash.calc('vistas_por_dia', {\n    title: 'Vistas por día y red',\n    description: 'Suma de vistas de las publicaciones de cada día de publicación, separada por red.',\n    inputs: ['publicaciones'],\n    fn: (publicaciones) => {\n      const m = new Map();\n      publicaciones.forEach((p) => { const k = p.fecha + '|' + p.red; m.set(k, (m.get(k) || 0) + Number(p.vistas)); });\n      return [...m].map(([k, vistas]) => ({ fecha: k.split('|')[0], red: k.split('|')[1], vistas }));\n    },\n  });\n</script>\n\n<script>\n  // Las referencias del reto (las puso Kenneth): empezamos en 1.659 el 21 de octubre y la meta es 2.659 el 19 de noviembre.\n  const INICIO = 1659, META = 2659, DIA1 = '2026-10-21', DIA30 = '2026-11-19';\n  const F = window.rtFmt, n = F.format(',d'), dec = F.format(',.1f'), pct = d3.format('.0%');\n  const REDES = ['TikTok', 'Instagram'];\n  const color = (r) => dash.colors[REDES.indexOf(r) >= 0 ? REDES.indexOf(r) : 2];\n  const fechaCorta = (s) => { const d = new Date(s + 'T12:00:00'); return d.getDate() + ' ' + ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'][d.getMonth()]; };\n  const falla = (el) => { el.innerHTML = ''; const p = document.createElement('div');\n    p.style.cssText = 'display:flex;align-items:center;justify-content:center;min-height:inherit;gap:.4rem;font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)';\n    const dot = document.createElement('span'); dot.style.cssText = 'width:.375rem;height:.375rem;border-radius:50%;background:var(--color-bad)';\n    p.append(dot, 'Failed to load'); el.append(p); };\n  const leyenda = (el) => { el.replaceChildren(...REDES.map((r) => { const s = document.createElement('span');\n    const sw = document.createElement('span'); sw.className = 'rt-sw'; sw.style.background = color(r); s.append(sw, r); return s; })); };\n  const tip = (box) => { let t = box.querySelector('.rt-tip'); if (!t) { t = document.createElement('div'); t.className = 'rt-tip'; t.hidden = true; box.append(t); } return t; };\n  const ejes = (g) => g.attr('font-size', null).attr('font-family', null).call((s) => s.selectAll('text').attr('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)'))\n    .call((s) => s.select('.domain').attr('stroke', 'var(--cds-chart-axis)')).call((s) => s.selectAll('.tick line').attr('stroke', 'var(--cds-chart-grid)'));\n\n  function textos() {\n    const r = dash.data('resumen');\n    const p = document.getElementById('rt-takeaway');\n    p.replaceChildren();\n    if (r.status !== 'ok' || !r.data.length) { const s = document.createElement('span'); s.className = 'dash-skeleton'; s.textContent = '—'; p.append(s); return; }\n    const x = r.data[0];\n    const mk = (field, txt) => { const s = document.createElement('b'); s.dataset.source = 'resumen'; s.dataset.field = field; s.dataset.row = '0'; s.textContent = txt; return s; };\n    p.append('Llevamos ', mk('vistas_total', n(x.vistas_total)), ' vistas y ', mk('nuevos', (x.nuevos >= 0 ? '+' : '') + n(x.nuevos)), ' seguidores. La que más se vio: ',\n      mk('mejor_pieza', x.mejor_pieza), ' en ', mk('mejor_red', x.mejor_red), ' (', mk('mejor_vistas', n(x.mejor_vistas)), '). El objetivo es subir las vistas: los seguidores vienen de ahí.');\n    document.querySelectorAll('[data-source=\"resumen\"][data-field]').forEach((el) => {\n      if (el.closest('#rt-takeaway')) return;\n      const v = x[el.dataset.field]; el.classList.remove('dash-skeleton');\n      if (v == null) { el.textContent = '—'; return; }\n      el.textContent = el.dataset.field === 'por_mil' ? dec(v) : el.dataset.field === 'nuevos' ? (v >= 0 ? '+' : '') + n(v) : n(v);\n    });\n  }\n\n  function barras() {\n    const box = document.getElementById('chart-dia'), d = dash.data('vistas_por_dia');\n    leyenda(document.getElementById('ley-dia'));\n    if (d.status === 'error') { falla(box); return; }\n    box.querySelector('svg')?.remove();\n    if (d.status !== 'ok') return;\n    const rows = d.data, W = Math.max(280, box.clientWidth), H = 240;\n    const fechas = [...new Set(rows.map((r) => r.fecha))].sort();\n    const y = d3.scaleLinear([0, d3.max(rows, (r) => r.vistas) || 1], [H - 28, 12]).nice();\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n    const gy = svg.append('g').call(d3.axisLeft(y).ticks(4).tickFormat(n).tickSize(-W)).call(ejes);\n    const ancho = d3.max(gy.selectAll('text').nodes(), (t) => t.getComputedTextLength()) || 20, ML = ancho + 10;\n    gy.attr('transform', `translate(${ML},0)`).call(d3.axisLeft(y).ticks(4).tickFormat(n).tickSize(-(W - ML))).call(ejes).select('.domain').remove();\n    const x0 = d3.scaleBand(fechas, [ML, W - 4]).padding(0.25), x1 = d3.scaleBand(REDES, [0, x0.bandwidth()]).padding(0.12);\n    svg.append('g').attr('transform', `translate(0,${H - 28})`).call(d3.axisBottom(x0).tickFormat(fechaCorta).tickSize(0)).call(ejes).call((g) => g.select('.domain').remove());\n    const t = tip(box);\n    svg.append('g').selectAll('rect').data(rows).join('rect')\n      .attr('x', (r) => x0(r.fecha) + x1(r.red)).attr('width', Math.min(32, x1.bandwidth())).attr('y', (r) => y(r.vistas)).attr('height', (r) => y(0) - y(r.vistas))\n      .attr('rx', 4).attr('fill', (r) => color(r.red))\n      .on('mousemove', (ev, r) => { const [mx, my] = d3.pointer(ev, box); t.hidden = false; t.replaceChildren();\n        const a = document.createElement('div'); a.className = 't'; a.textContent = fechaCorta(r.fecha);\n        const b = document.createElement('div'); const sw = document.createElement('span'); sw.className = 'rt-sw'; sw.style.background = color(r.red); b.append(sw, `${r.red}: ${n(r.vistas)} vistas`);\n        t.append(a, b); t.style.left = Math.min(mx + 12, box.clientWidth - t.offsetWidth) + 'px'; t.style.top = Math.max(0, my - 40) + 'px'; })\n      .on('mouseleave', () => { t.hidden = true; });\n  }\n\n  function lineas(boxId, d, series, opciones) {\n    const box = document.getElementById(boxId);\n    if (d.status === 'error') { falla(box); return; }\n    box.querySelector('svg')?.remove();\n    if (d.status !== 'ok') return;\n    const W = Math.max(280, box.clientWidth), H = 240;\n    const pts = series.flatMap((s) => s.puntos);\n    const xs = pts.map((p) => p.x).concat(opciones.xExtra || []);\n    const x = d3.scaleUtc(d3.extent(xs), [0, 1]);\n    const yMax = d3.max(pts.map((p) => p.y).concat(opciones.yExtra || [])) || 1, yMin = opciones.yMin ?? 0;\n    const y = d3.scaleLinear([yMin, yMax], [H - 28, 12]).nice();\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n    const gy = svg.append('g').call(d3.axisLeft(y).ticks(4).tickFormat(n)).call(ejes);\n    const ML = (d3.max(gy.selectAll('text').nodes(), (t) => t.getComputedTextLength()) || 20) + 10;\n    const etiquetas = series.map((s) => (s.nombre ? s.nombre + ' ' + n(s.puntos[s.puntos.length - 1]?.y ?? 0) : ''));\n    const prueba = svg.append('text').style('font-size', 'var(--cds-font-size-caption)');\n    const MR = d3.max(etiquetas, (e) => (prueba.text(e), prueba.node().getComputedTextLength())) + 12; prueba.remove();\n    x.range([ML, W - Math.max(16, MR)]);\n    gy.attr('transform', `translate(${ML},0)`).call(d3.axisLeft(y).ticks(4).tickFormat(n).tickSize(-(W - ML - Math.max(16, MR)))).call(ejes).select('.domain').remove();\n    svg.append('g').attr('transform', `translate(0,${H - 28})`).call(d3.axisBottom(x).ticks(Math.max(2, Math.floor(W / 110))).tickFormat((t) => fechaCorta(d3.utcFormat('%Y-%m-%d')(t))).tickSize(0)).call(ejes).call((g) => g.select('.domain').remove());\n    if (opciones.meta) svg.append('line').attr('x1', x(opciones.meta[0].x)).attr('y1', y(opciones.meta[0].y)).attr('x2', x(opciones.meta[1].x)).attr('y2', y(opciones.meta[1].y))\n      .attr('stroke', 'var(--cds-chart-reference)').attr('stroke-width', 1.5).attr('stroke-dasharray', '5 4');\n    series.forEach((s, i) => {\n      const c = s.color;\n      svg.append('path').datum(s.puntos).attr('fill', 'none').attr('stroke', c).attr('stroke-width', 2).attr('stroke-linecap', 'round').attr('stroke-linejoin', 'round')\n        .attr('d', d3.line((p) => x(p.x), (p) => y(p.y)));\n      svg.append('g').selectAll('circle').data(s.puntos).join('circle').attr('cx', (p) => x(p.x)).attr('cy', (p) => y(p.y)).attr('r', 3.5).attr('fill', c);\n      const ult = s.puntos[s.puntos.length - 1];\n      if (ult && etiquetas[i]) svg.append('text').attr('x', x(ult.x) + 8).attr('y', y(ult.y) + 4 + (i ? 12 : 0) * (series.length > 1 && Math.abs(y(series[0].puntos.at(-1).y) - y(ult.y)) < 14 ? 1 : 0))\n        .attr('fill', c).style('font-size', 'var(--cds-font-size-caption)').text(etiquetas[i]);\n    });\n  }\n\n  function historial() {\n    const d = dash.data('historial');\n    leyenda(document.getElementById('ley-hist'));\n    const series = REDES.map((r) => ({ nombre: r, color: color(r), puntos: (d.status === 'ok' ? d.data : []).filter((h) => h.red === r)\n      .map((h) => ({ x: new Date(h.medido), y: Number(h.vistas) })).sort((a, b) => a.x - b.x) }));\n    lineas('chart-hist', d, series, {});\n  }\n\n  function seguidores() {\n    const d = dash.data('seguidores');\n    const puntos = (d.status === 'ok' ? d.data : []).map((s) => ({ x: new Date(s.fecha + 'T12:00:00'), y: Number(s.total) })).sort((a, b) => a.x - b.x);\n    const a = new Date(DIA1 + 'T12:00:00'), b = new Date(DIA30 + 'T12:00:00');\n    lineas('chart-seg', d, [{ nombre: 'Seguidores', color: dash.colors[0], puntos }],\n      { xExtra: [b], yExtra: [META], yMin: 1600, meta: [{ x: a, y: INICIO }, { x: b, y: META }] });\n  }\n\n  let orden = { k: 'vistas', dir: -1 };\n  document.querySelectorAll('.rt-table th button').forEach((b) => b.addEventListener('click', () => {\n    orden = { k: b.dataset.k, dir: orden.k === b.dataset.k ? -orden.dir : (['fecha', 'pieza', 'red'].includes(b.dataset.k) ? 1 : -1) };\n    tabla();\n  }));\n  function tabla() {\n    const d = dash.data('publicaciones'), body = document.getElementById('rt-filas');\n    body.replaceChildren();\n    document.querySelectorAll('.rt-table th').forEach((th) => th.setAttribute('aria-sort', th.dataset.field === orden.k ? (orden.dir > 0 ? 'ascending' : 'descending') : 'none'));\n    if (d.status !== 'ok') return;\n    const max = d3.max(d.data, (r) => Number(r.vistas)) || 1;\n    const rows = d.data.slice().sort((a, b) => { const va = a[orden.k], vb = b[orden.k];\n      return (typeof va === 'number' || typeof vb === 'number' ? (Number(va ?? -1) - Number(vb ?? -1)) : String(va).localeCompare(String(vb))) * orden.dir; });\n    rows.forEach((r) => {\n      const tr = document.createElement('tr');\n      tr.dataset.key = encodeURIComponent(r.codigo) + ',' + encodeURIComponent(r.red);\n      const td = (txt, cls) => { const c = document.createElement('td'); if (cls) c.className = cls; c.textContent = txt; tr.append(c); return c; };\n      td(fechaCorta(r.fecha) + ' ' + r.hora);\n      td(r.pieza);\n      const cr = td(''); const pill = document.createElement('span'); pill.className = 'rt-pill'; pill.textContent = r.red; pill.style.borderColor = color(r.red); cr.append(pill);\n      const cv = td(n(r.vistas), 'n'); const bar = document.createElement('span'); bar.className = 'rt-bar'; bar.style.width = (3 * r.vistas / max) + 'rem'; bar.style.background = color(r.red); cv.append(bar);\n      td(r.visto == null ? '—' : pct(r.visto), 'n');\n      td(n(r.reacciones), 'n opt'); td(n(r.compartidos), 'n opt'); td(n(r.comentarios), 'n opt');\n      body.append(tr);\n    });\n  }\n\n  dash.onData(() => { textos(); barras(); historial(); seguidores(); tabla(); });\n</script>\n"}